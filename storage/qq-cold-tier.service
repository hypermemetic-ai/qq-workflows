[Unit]
Description=File access evidence and verified regenerable artifact retention
After=local-fs.target

[Service]
ExecStart=/usr/bin/python3 %h/.local/share/qq-cold-tier/current/cold-tier.py watch
Restart=on-failure
RestartSec=10
Nice=15
CPUQuota=15%
MemoryHigh=192M
MemoryMax=320M
MemorySwapMax=0
TasksMax=16
UMask=0077
NoNewPrivileges=yes
TimeoutStopSec=10

[Install]
WantedBy=default.target
