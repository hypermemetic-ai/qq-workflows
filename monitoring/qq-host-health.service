[Unit]
Description=Host resource and uptime evidence collector
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/qq-host-monitor/current/host-health.py --state-dir %h/.local/state/qq-host-monitor --policy %h/.config/qq-host-monitor/collector.json
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Restart=always
RestartSec=10
Nice=10
CPUQuota=20%
MemoryHigh=96M
MemoryMax=192M
TasksMax=32
UMask=0077
NoNewPrivileges=yes
# Filesystem namespacing in a user unit creates a child user namespace and blocks
# host /proc FD/cwd reads. Keep host credentials for read-only process attribution.
TimeoutStopSec=5

[Install]
WantedBy=default.target
