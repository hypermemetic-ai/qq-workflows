{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qq.grok-reviewer-arm-result/v1",
  "title": "Normalized output written by one approved benchmark arm launcher",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "arm_id",
    "case_id",
    "model",
    "provider_model",
    "mode",
    "effective_config",
    "verdict",
    "findings",
    "usage",
    "telemetry",
    "isolation"
  ],
  "properties": {
    "schema": {
      "const": "qq.grok-reviewer-arm-result/v1"
    },
    "arm_id": {
      "enum": [
        "qq-mini-qa",
        "pr-agent",
        "misospace-pr-reviewer"
      ]
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "provider_model": {
      "const": "grok-4.6"
    },
    "mode": {
      "type": "object"
    },
    "effective_config": {
      "type": "object",
      "description": "Complete, secret-free effective tool/model configuration, including unavoidable defaults."
    },
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "line",
          "body",
          "severity",
          "confidence",
          "blocks_merge"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ]
          },
          "blocks_merge": {
            "type": "boolean"
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool_reported": {
          "$ref": "#/$defs/partialUsage"
        },
        "host_captured": {
          "$ref": "#/$defs/completeUsage"
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_count",
        "retries",
        "failures",
        "truncation_events",
        "context_events"
      ],
      "properties": {
        "request_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "failures": {
          "type": "integer",
          "minimum": 0
        },
        "truncation_events": {
          "type": "integer",
          "minimum": 0
        },
        "context_events": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_findings_visible",
        "publishing"
      ],
      "properties": {
        "prior_findings_visible": {
          "const": false
        },
        "publishing": {
          "const": false
        }
      }
    },
    "provider_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_models",
        "response_models"
      ],
      "properties": {
        "request_models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "const": "grok-4.6"
          }
        },
        "response_models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "const": "grok-4.6"
          }
        }
      }
    }
  },
  "$defs": {
    "partialUsage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "processed_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "completeUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "reasoning_tokens",
        "processed_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "processed_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "arm_id": {
            "const": "qq-mini-qa"
          }
        },
        "required": [
          "arm_id"
        ]
      },
      "then": {
        "required": [
          "provider_evidence"
        ]
      }
    }
  ]
}
